rules_version = '2';

// Security model: this app has no authentication layer yet (Phase 1-2 scope
// is a single classroom with 1-2 trusted teachers). Access is restricted by
// requiring the Firestore Web SDK's App Check-less client, which is NOT a
// real security boundary on its own — until Firebase Auth is added (planned
// for a later hardening pass), treat this project's Firestore as accessible
// to anyone with the project's public config. Do not store sensitive PII
// (e.g. full birthdates, addresses) beyond what's needed for classroom use,
// and do not reuse this project for other purposes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /children/{childId} {
      allow read, write: if true;
    }
    match /lessonAreas/{areaId} {
      allow read, write: if true;
    }
    match /lessons/{lessonId} {
      allow read, write: if true;
    }
    match /childLessonRecords/{recordId} {
      allow read, write: if true;
    }
    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
